{
  "name": "demo-streaming",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/worker.jsx --bundle --format=esm --platform=neutral --conditions=workerd,worker,browser,import --main-fields=module,main --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/worker.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": { "react": "*", "react-dom": "*", "scheduler": "*" },
  "devDependencies": { "esbuild": "latest", "wrangler": "latest" }
}
